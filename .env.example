# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Supabase Publishable Keys (optional, for Supabase CLI/integrations)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_URL=https://your-project.supabase.co

# Postgres (optional, for direct database access / migrations)
POSTGRES_URL=postgres://postgres.your-project:your-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://postgres.your-project:your-password@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://postgres.your-project:your-password@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_DATABASE=postgres

# App URL
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Encryption key for integration credentials (32 bytes hex = 64 chars)
ENCRYPTION_KEY=your-64-char-hex-encryption-key

# Fintoc (Banking/SPEI)
FINTOC_API_KEY=your-fintoc-api-key
FINTOC_SECRET_KEY=your-fintoc-secret-key
FINTOC_WEBHOOK_SECRET=your-fintoc-webhook-secret
FINTOC_JWS_PRIVATE_KEY=your-jws-private-key-pem

# Syntage (SAT)
SYNTAGE_API_KEY=your-syntage-api-key
SYNTAGE_WEBHOOK_SECRET=your-syntage-webhook-secret

# Odoo (ERP) - default credentials, can be overridden per company
ODOO_URL=https://your-odoo.odoo.com
ODOO_DB=your-odoo-db
ODOO_USERNAME=your-odoo-username
ODOO_PASSWORD=your-odoo-password

# Resend (Email)
RESEND_API_KEY=your-resend-api-key

# Cron job authentication
CRON_SECRET=your-cron-secret

# Optional: API base URL (defaults to same origin)
# NEXT_PUBLIC_API_URL=
