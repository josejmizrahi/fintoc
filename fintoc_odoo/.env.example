# ══════════════════════════════════════════════════════════════
# Payana-Fintoc — Variables de Entorno
# ══════════════════════════════════════════════════════════════

# ── Fintoc ──
FINTOC_SECRET_KEY=sk_test_XXXX
FINTOC_PUBLIC_KEY=pk_test_XXXX
FINTOC_WEBHOOK_SECRET=whsec_XXXX
FINTOC_ACCOUNT_ID=acc_XXXX
JWS_PRIVATE_KEY_PATH=./private_key.pem

# ── Odoo ──
ODOO_URL=https://tu-empresa.odoo.com
ODOO_DATABASE=tu_base_de_datos
ODOO_USERNAME=admin@tuempresa.com
ODOO_PASSWORD=XXXX

# ── App ──
APP_NAME=Payana-Fintoc
APP_PORT=8001
WEBHOOK_PATH=/fintoc/webhook
BASE_URL=https://tu-servidor.tuempresa.com
SECRET_KEY=cambia-esto-en-produccion
DEBUG=false

# ── Database ──
# SQLite (default) o PostgreSQL para producción
DATABASE_URL=sqlite:///./payana_fintoc.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/payana_fintoc

# ── SAT ──
SAT_WSDL_URL=https://consultaqr.facturaelectronica.sat.gob.mx/ConsultaCFDIService.svc?WSDL

# ── Notificaciones (opcional) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@tuempresa.com
SMTP_PASSWORD=XXXX
NOTIFICATION_EMAIL_FROM=notificaciones@tuempresa.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Multi-empresa ──
DEFAULT_COMPANY_ID=1
